PORT=8080
HOST=127.0.0.1
DATABASE_PATH=./data/gml-shield.sqlite
UPLOAD_DIR=./var/private-uploads
SESSION_TTL_SECONDS=900
# Generate each key independently from a cryptographically secure source.
# Encryption key: exactly 32 random bytes, base64 encoded.
GML_SECRET_KEY_B64=
# Audit HMAC key: at least 32 random bytes, base64 encoded.
GML_AUDIT_KEY_B64=
# Session-token lookup key: at least 32 random bytes, base64 encoded.
GML_SESSION_KEY_B64=
